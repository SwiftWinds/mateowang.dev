---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Search from "../../components/Search.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog — Mateo Wang" description="Blog posts about software development, ML, and more.">
	<div class="blog-wrapper">
		<nav class="breadcrumb">
			<a href="/">Home</a>
			<span class="sep">/</span>
			<span class="current">Blog</span>
		</nav>

		<header class="blog-header">
			<h1 class="blog-title">Blog</h1>
			<p class="blog-subtitle">
				Thoughts on software, ML, and things I'm building.
			</p>
		</header>

		<Search />

		{
			allTags.length > 0 && (
				<div class="tag-cloud">
					<a href="/blog" class="tag-pill active">All</a>
					{allTags.map((tag) => (
						<a href={`/blog/tag/${tag}`} class="tag-pill">
							{tag}
						</a>
					))}
				</div>
			)
		}

		<div class="posts-grid">
			{
				posts.map((post) => (
					<div
						data-search-card
						data-search-title={post.data.title}
						data-search-description={post.data.description}
						data-search-tags={post.data.tags.join(" ")}
					>
						<PostCard
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							tags={post.data.tags}
							readingTime={(post as any).data.readingTime}
							href={`/blog/${post.id}`}
						/>
					</div>
				))
			}
		</div>

		{
			posts.length === 0 && (
				<div class="empty-state">
					<p>No posts yet. Check back soon!</p>
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.blog-wrapper {
		position: relative;
		z-index: 1;
		max-width: 760px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	.breadcrumb {
		margin-bottom: 2rem;
		font-size: 0.875rem;
		opacity: 0.7;
	}

	.breadcrumb a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.breadcrumb .sep {
		margin: 0 0.5rem;
		opacity: 0.5;
	}

	.breadcrumb .current {
		opacity: 0.8;
	}

	.blog-header {
		margin-bottom: 2rem;
	}

	.blog-title {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		background: linear-gradient(135deg, var(--text-color), var(--accent-color));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.blog-subtitle {
		font-size: 1.1rem;
		opacity: 0.6;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.tag-pill {
		display: inline-block;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.8rem;
		font-weight: 500;
		background: rgba(189, 147, 249, 0.08);
		color: var(--text-color);
		border: 1px solid rgba(255, 255, 255, 0.08);
		text-decoration: none;
		opacity: 0.7;
		transition:
			opacity 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.tag-pill:hover {
		opacity: 1;
		background: rgba(189, 147, 249, 0.15);
		border-color: rgba(189, 147, 249, 0.3);
		text-decoration: none;
	}

	.tag-pill.active {
		opacity: 1;
		background: rgba(189, 147, 249, 0.2);
		color: var(--accent-color);
		border-color: rgba(189, 147, 249, 0.4);
	}

	.posts-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.empty-state {
		text-align: center;
		padding: 3rem;
		opacity: 0.5;
	}

	@media (max-width: 640px) {
		.blog-title {
			font-size: 2rem;
		}
	}
</style>
