---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Mateo Wang">
	<div class="home-wrapper">
		<div class="card" id="card">
			<div class="edge-light" id="edge-light"></div>
			<h1 class="name">Mateo Wang</h1>
			<div class="subtitle">Software Developer • ML Engineer</div>
			<nav class="blog-nav">
				<a href="/blog">Blog</a>
			</nav>
			<div class="social-links">
				<a
					href="https://github.com/SwiftWinds"
					class="social-link github-link"
					target="_blank"
					rel="noopener"
					aria-label="GitHub"
				>
